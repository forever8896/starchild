{
  "name": "starchild-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Starchild web shell — the full experience in the browser, local-first (PRD: docs/web-app-prd.md).",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build ../src-tauri/core --target web --out-dir ../../web/src/wasm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^3.2.4"
  }
}
